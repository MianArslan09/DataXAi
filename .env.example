# Copy to .env and fill in real values. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-real-50-char-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dataxai
POSTGRES_USER=dataxai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# ^ DataXAi's own application/warehouse database (Django ORM). Do not
#   point this at a customer's/SME's upstream system.

# M1 ETL external/upstream source (SQLAlchemy, NOT Django ORM) - simulates
# the SME's own existing database that DataXAi reads FROM. Must stay a
# separate connection from the POSTGRES_* vars above - see Volume 4.1.
# Windows defaults; Compose overrides host/port for web, worker and beat.
# Set the existing source role password; this does NOT rotate database credentials.
SOURCE_POSTGRES_HOST=127.0.0.1
SOURCE_POSTGRES_PORT=5433
SOURCE_POSTGRES_DB=dataxai_source
SOURCE_POSTGRES_USER=dataxai_source
# Shared dotenv: single-quoted literal; no apostrophe or trailing backslash.
# Otherwise supply the raw password via process environment; see docs/SOURCE_DATABASE_CONFIGURATION.md.
SOURCE_POSTGRES_PASSWORD='replace-with-existing-source-role-password'
# Optional complete, percent-encoded URL override. Blank uses components.
SOURCE_DATABASE_URL=
# Optional test-only URL override; omit to use the application source URL.
# TEST_SOURCE_DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@127.0.0.1:5433/dataxai_source
ETL_DATA_DIR=/app/data

REDIS_URL=redis://cache:6379/0
REDIS_CACHE_URL=redis://cache:6379/1

GROQ_API_KEY=your-groq-api-key-from-console.groq.com
GROQ_NARRATION_MODEL=openai/gpt-oss-120b
GROQ_CHATBOT_MODEL=openai/gpt-oss-20b
