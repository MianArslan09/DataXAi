{
  "name": "dataxai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "stage5:capture": "node stage5/evidence.mjs capture",
    "stage5:verify-raw": "node stage5/evidence.mjs verify-raw",
    "stage5:compose": "node stage5/evidence.mjs compose",
    "stage5:verify": "node stage5/evidence.mjs verify",
    "format:check": "prettier --check src tests/*.ts stage5 *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
